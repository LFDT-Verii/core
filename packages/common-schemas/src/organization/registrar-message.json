{
    "$id": "registrar-message",
    "type": "object",
    "properties": {
        "messageType": {
            "type": "string",
            "enum": [
                "test",
                "create_tenant"
            ]
        },
        "messageId": {
            "type": "string"
        },
        "payload": {
            "type": "object",
            "properties": {
                "caoDid": {
                    "type": "string"
                },
                "caoService": {
                    "$ref": "did-service#"
                },
                "create_tenant": {
                    "type": "object",
                    "properties": {
                        "did": {
                            "type": "string"
                        },
                        "serviceIds": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "keys": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "kidFragment": {
                                        "type": "string",
                                        "pattern": "^#[a-zA-Z0-9-_:?=&;]+$"
                                    },
                                    "purposes": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "key": {
                                        "type": "string",
                                        "description": "The private key in the legacy `encoding`. Sent only for SECP256K1 keys."
                                    },
                                    "publicKey": {
                                        "type": "string",
                                        "description": "The public key in the legacy `encoding`. Sent only for SECP256K1 keys."
                                    },
                                    "jwk": {
                                        "type": "object",
                                        "description": "The private key as a JWK. Receivers should import this in preference to `key`.",
                                        "properties": {
                                            "kty": {
                                                "type": "string",
                                                "enum": [
                                                    "EC"
                                                ]
                                            },
                                            "crv": {
                                                "type": "string"
                                            },
                                            "x": {
                                                "type": "string"
                                            },
                                            "y": {
                                                "type": "string"
                                            },
                                            "d": {
                                                "type": "string"
                                            }
                                        },
                                        "required": [
                                            "kty",
                                            "crv",
                                            "x",
                                            "y",
                                            "d"
                                        ]
                                    },
                                    "publicJwk": {
                                        "type": "object",
                                        "description": "The public key as a JWK. Receivers should import this in preference to `publicKey`.",
                                        "properties": {
                                            "kty": {
                                                "type": "string",
                                                "enum": [
                                                    "EC"
                                                ]
                                            },
                                            "crv": {
                                                "type": "string"
                                            },
                                            "x": {
                                                "type": "string"
                                            },
                                            "y": {
                                                "type": "string"
                                            }
                                        },
                                        "required": [
                                            "kty",
                                            "crv",
                                            "x",
                                            "y"
                                        ],
                                        "not": {
                                            "required": [
                                                "d"
                                            ]
                                        }
                                    },
                                    "algorithm": {
                                        "type": "string",
                                        "enum": [
                                            "SECP256K1",
                                            "ES256",
                                            "ED25519"
                                        ]
                                    },
                                    "encoding": {
                                        "type": "string",
                                        "description": "The encoding of `key` and `publicKey`, or `jwk` when the key is sent only as `jwk` and `publicJwk`.",
                                        "enum": [
                                            "hex",
                                            "base58",
                                            "jwk"
                                        ]
                                    }
                                },
                                "if": {
                                    "required": [
                                        "algorithm"
                                    ],
                                    "properties": {
                                        "algorithm": {
                                            "not": {
                                                "enum": [
                                                    "SECP256K1",
                                                    "ED25519"
                                                ]
                                            }
                                        }
                                    }
                                },
                                "then": {
                                    "description": "Hex carries no curve, so keys of other algorithms are sent only as JWKs.",
                                    "required": [
                                        "encoding",
                                        "jwk",
                                        "publicJwk"
                                    ],
                                    "properties": {
                                        "encoding": {
                                            "enum": [
                                                "jwk"
                                            ]
                                        }
                                    },
                                    "not": {
                                        "anyOf": [
                                            {
                                                "required": [
                                                    "key"
                                                ]
                                            },
                                            {
                                                "required": [
                                                    "publicKey"
                                                ]
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "required": [
        "messageType",
        "messageId"
    ]
}
