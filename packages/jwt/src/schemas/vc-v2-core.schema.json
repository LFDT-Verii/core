{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://velocitynetwork.foundation/schemas/w3c-vc-v2-core.schema.json",
  "title": "W3C Verifiable Credential 2.0 core structure",
  "type": "object",
  "required": ["@context", "type", "issuer", "credentialSubject"],
  "properties": {
    "@context": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": [
        {
          "const": "https://www.w3.org/ns/credentials/v2"
        }
      ],
      "additionalItems": {
        "$ref": "#/$defs/contextEntry"
      }
    },
    "id": {
      "$ref": "#/$defs/uri"
    },
    "type": {
      "oneOf": [
        {
          "const": "VerifiableCredential"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/typeTerm"
          },
          "contains": {
            "const": "VerifiableCredential"
          }
        }
      ]
    },
    "issuer": {
      "oneOf": [
        {
          "$ref": "#/$defs/uri"
        },
        {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {
              "$ref": "#/$defs/uri"
            }
          }
        }
      ]
    },
    "validFrom": {
      "$ref": "#/$defs/dateTime"
    },
    "validUntil": {
      "$ref": "#/$defs/dateTime"
    },
    "credentialSubject": {
      "oneOf": [
        {
          "$ref": "#/$defs/subject"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/subject"
          }
        }
      ]
    },
    "credentialSchema": {
      "oneOf": [
        {
          "$ref": "#/$defs/schemaDescriptor"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/schemaDescriptor"
          }
        }
      ]
    }
  },
  "$defs": {
    "contextEntry": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https://"
        },
        {
          "type": "object",
          "minProperties": 1
        }
      ]
    },
    "dateTime": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time"
    },
    "schemaDescriptor": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uri"
        },
        "type": {
          "$ref": "#/$defs/typeTerm"
        }
      }
    },
    "subject": {
      "type": "object",
      "minProperties": 1
    },
    "typeTerm": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "uri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "format": "uri"
    }
  }
}
