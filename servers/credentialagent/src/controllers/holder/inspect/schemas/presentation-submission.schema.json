{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Presentation Submission",
  "$id": "https://velocitycareerlabs.io/presentation-submission.schema.json",
  "type": "object",
  "properties": {
    "presentation_submission": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "definition_id": { "type": "string" },
        "locale": { "type": "string" },
        "descriptor_map": {
          "type": "array",
          "items": { "$ref": "#/definitions/descriptor" }
        }
      },
      "required": ["descriptor_map"],
      "additionalProperties": false
    }
  },
  "definitions": {
    "descriptor": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "path": {
          "type": "string",
          "description": "Where the credential is in the submitted presentation. Must be `$.verifiableCredential[<n>]`, where `<n>` is an index from 0 to 999 with no leading zeros. Any other value is rejected with 400 `presentation_jsonpath_unsupported`. An index with no credential is rejected with 400 `presentation_jsonpath_empty`."
        },
        "path_nested": {
          "description": "Not used. The credential is read from `path`.",
          "allOf": [{ "$ref": "#/definitions/descriptor" }]
        },
        "format": {
          "type": "string",
          "enum": ["jwt", "jwt_vc", "jwt_vp", "ldp", "ldp_vc", "ldp_vp", "JWT"]
        }
      },
      "required": ["id", "path", "format"],
      "additionalProperties": false
    }
  },
  "required": ["presentation_submission"]
}